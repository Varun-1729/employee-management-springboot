<html>
<head>
    <title>Employee Form</title>
</head>

<body>

<center>

    <form action="addEmp">

        <table align="center">

            <tr>
                <td>No :</td>
                <td><input type="number" name="empId"/></td>
            </tr>

            <tr>
                <td>Name :</td>
                <td><input type="text" name="empName"/></td>
            </tr>

            <tr>
                <td>Address :</td>
                <td><input type="text" name="empAdd"/></td>
            </tr>

            <tr>
                <td>
                    <input type="reset" value="Reset"/>
                </td>

                <td>
                    <input type="submit" value="Submit"/>
                </td>
            </tr>

        </table>

    </form>

</center>

</body>
</html>